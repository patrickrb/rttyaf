<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Range rings (faint violet-grey, within the 66dp safe zone). -->
    <path android:pathData="M54,57 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0"
        android:fillColor="#00000000"
        android:strokeColor="#33ADA6DC"
        android:strokeWidth="0.6" />
    <path android:pathData="M54,57 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0"
        android:fillColor="#00000000"
        android:strokeColor="#33ADA6DC"
        android:strokeWidth="0.6" />

    <!-- Top-half signal arcs (violet, outer to inner, increasing opacity). -->
    <path android:pathData="M22,57 A32,32 0 0,1 86,57"
        android:fillColor="#00000000"
        android:strokeColor="#55A78BFA"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    <path android:pathData="M30,57 A24,24 0 0,1 78,57"
        android:fillColor="#00000000"
        android:strokeColor="#99A78BFA"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />
    <path android:pathData="M38,57 A16,16 0 0,1 70,57"
        android:fillColor="#00000000"
        android:strokeColor="#FFD7C9FF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- RTTY mark/space two-tone motif: two rounded FSK bars.
         Drawn as round-capped vertical strokes so the ends are pill-shaped. -->
    <!-- MARK bar (violet). -->
    <path android:pathData="M50.5,47 L50.5,67"
        android:strokeWidth="6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="50.5" android:startY="46"
                android:endX="50.5" android:endY="68">
                <item android:offset="0" android:color="#FFD7C9FF" />
                <item android:offset="0.5" android:color="#FFA78BFA" />
                <item android:offset="1" android:color="#FF7C5CFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- SPACE bar (fuchsia). -->
    <path android:pathData="M57.5,47 L57.5,67"
        android:strokeWidth="6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="57.5" android:startY="46"
                android:endX="57.5" android:endY="68">
                <item android:offset="0" android:color="#FFFFC4E4" />
                <item android:offset="0.5" android:color="#FFF472B6" />
                <item android:offset="1" android:color="#FFD64F97" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tiny signal sparks along the outer arc edges. -->
    <path android:pathData="M22,57 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0"
        android:fillColor="#80D7C9FF" />
    <path android:pathData="M86,57 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0"
        android:fillColor="#80D7C9FF" />
    <path android:pathData="M30,57 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0"
        android:fillColor="#80FFC4E4" />
    <path android:pathData="M78,57 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0"
        android:fillColor="#80FFC4E4" />
</vector>
